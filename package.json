{
  "name": "testmaker",
  "private": true,
  "version": "2.4.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "verify:paper5": "node scripts/verify-paper5.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "test:gforms": "node --import ./scripts/register-ts.mjs scripts/test-gforms-phase1.mjs && node --import ./scripts/register-ts.mjs scripts/test-gforms-phase234.mjs",
    "test:gestures": "node --import ./scripts/register-ts.mjs scripts/test-exam-gestures.mjs",
    "test:blooms": "node --import ./scripts/register-ts.mjs scripts/test-blooms-parity.mjs",
    "test:sorting": "node --import ./scripts/register-ts.mjs scripts/test-builder-sorting.mjs",
    "test:emergency": "node --import ./scripts/register-ts.mjs scripts/test-emergency-fallback.mjs",
    "test:emergency:sim": "node --import ./scripts/register-ts.mjs scripts/simulate-emergency-auto-trigger-import.mjs",
    "test:tos-citations": "node --import ./scripts/register-ts.mjs scripts/test-tos-citations-dual-links.mjs",
    "test:cambridge-links": "node --import ./scripts/register-ts.mjs scripts/test-post-upload-cambridge-links.mjs",
    "test:fullscreen-grace": "node scripts/test-fullscreen-grace-period.mjs",
    "test:security-tiers": "node --import ./scripts/register-ts.mjs scripts/test-tiered-security-system.mjs",
    "test:pilot-exam": "node --import ./scripts/register-ts.mjs scripts/test-pilot-exam-resolution.mjs",
    "test:custom-subject": "node --import ./scripts/register-ts.mjs scripts/test-custom-subject-and-latency.mjs",
    "test:keyboard-controls": "node --import ./scripts/register-ts.mjs scripts/test-exam-keyboard-controls.mjs",
    "test:inline-gaps": "node --import ./scripts/register-ts.mjs scripts/test-inline-choice-gaps.mjs",
    "test:fillable-tables": "node --import ./scripts/register-ts.mjs scripts/test-fillable-data-tables.mjs",
    "test:submission-tombstones": "node scripts/test-submission-deletion-tombstones.mjs",
    "test:resource-booklet": "node --import ./scripts/register-ts.mjs scripts/test-resource-booklet.mjs",
    "test:saved-test-source": "node --import ./scripts/register-ts.mjs scripts/test-saved-test-source-of-truth.mjs",
    "test:manual-grading": "node --import ./scripts/register-ts.mjs scripts/test-manual-grading-persistence.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:draft": "npm run build && npx netlify deploy --dir=dist",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist",
    "mobile:build": "tsc -b && vite build && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npm run mobile:build && npx cap open android",
    "mobile:ios": "npm run mobile:build && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@cf-wasm/photon": "^0.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/jszip": "^3.4.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}