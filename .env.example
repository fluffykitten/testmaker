# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI Configuration — Get your key from https://aistudio.google.com/apikey
# Single Key (Standard Mode)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Dual / Multi-Key Turbo Mode (Optional — 2x Faster Extraction & Double Rate Limits)
# Account 2 Gemini API Key:
VITE_GEMINI_API_KEY_2=your-second-gemini-api-key-from-account-2
# Alternatively, comma-separated list:
# VITE_GEMINI_API_KEYS=key1,key2

VITE_GEMINI_MODEL=gemini-1.5-flash

# Google Drive Cloud Backup & Restore + Google Forms Export (Optional)
# Create an OAuth 2.0 Web Client ID in Google Cloud Console (APIs & Services → Credentials):
# Also enable the Google Forms API: https://console.cloud.google.com/apis/library/forms.googleapis.com
VITE_GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudflare R2 Media & AI Proxy Worker (10 GB Free Storage, $0 Egress Fees, Unblocked in Indonesia)
VITE_R2_MEDIA_ENDPOINT=https://testmaker-media.icmadani.workers.dev
VITE_R2_UPLOAD_SECRET=tm_r2_uploader_secret_2026
VITE_CLOUDFLARE_WORKER_URL=https://testmaker-media.icmadani.workers.dev

# Cloudflare Turnstile Anti-Bot Security (100% Free, Unlimited Challenges, Invisible Mode)
# Get your Site Key from Cloudflare Dashboard (Security → Turnstile):
# For local testing, you can use Cloudflare's dummy always-pass invisible key: 2x00000000000000000000AB
VITE_TURNSTILE_SITE_KEY=2x00000000000000000000AB
